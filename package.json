{
  "name": "skill-hub",
  "version": "1.0.2",
  "private": true,
  "description": "Skill Hub desktop application",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev:renderer": "set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5201 --strictPort",
    "dev": "set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && set \"CI=false\" && set \"CARGO_INCREMENTAL=0\" && set \"CARGO_BUILD_JOBS=1\" && node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "build": "set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/typescript/bin/tsc --noEmit && set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit && set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && set \"CI=false\" && set \"CARGO_INCREMENTAL=0\" && set \"CARGO_BUILD_JOBS=1\" && node ./node_modules/@tauri-apps/cli/tauri.js build",
    "build:main": "set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/typescript/bin/tsc -p tsconfig.node.json",
    "build:renderer": "set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/vite/bin/vite.js build",
    "package:win": "npm run build && electron-builder --win portable",
    "package:win:installer": "npm run build && electron-builder --win nsis",
    "typecheck": "set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/typescript/bin/tsc --noEmit && set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit",
    "start": "electron dist/main/main/index.js",
    "dev:main": "set \"PATH=C:/Program Files/nodejs;C:/Users/chenle/.cargo/bin;%PATH%\" && node ./node_modules/typescript/bin/tsc -p tsconfig.node.json --watch",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron dist/main/main/index.js",
    "dev:app": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:full": "npm run build:main && npm run dev:app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.skillhub.desktop",
    "productName": "SkillHub",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/default-remote-summaries.json",
        "to": "default-remote-summaries.json"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "icon": "buildResources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SkillHub-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkillHub",
      "installerIcon": "buildResources/icon.ico",
      "uninstallerIcon": "buildResources/icon.ico",
      "uninstallDisplayName": "SkillHub ${version}",
      "artifactName": "SkillHub-${version}-Setup.exe"
    }
  }
}
