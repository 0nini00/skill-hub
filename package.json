{
  "name": "skill-hub",
  "version": "1.0.6",
  "private": true,
  "description": "Skill Hub desktop application",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1 --port 5201 --strictPort",
    "dev": "set \"CI=\" && set \"CARGO_INCREMENTAL=0\" && set \"CARGO_BUILD_JOBS=1\" && tauri dev",
    "build": "tsc --noEmit && set \"CI=\" && set \"CARGO_INCREMENTAL=0\" && set \"CARGO_BUILD_JOBS=1\" && tauri build",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
