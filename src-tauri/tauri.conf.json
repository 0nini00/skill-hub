{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skill Hub",
  "version": "0.1.1",
  "identifier": "com.skillhub.app",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5201",
    "beforeDevCommand": "C:\\PROGRA~1\\nodejs\\node.exe node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5201 --strictPort",
    "beforeBuildCommand": "C:\\PROGRA~1\\nodejs\\node.exe node_modules/vite/bin/vite.js build"
  },
  "app": {
    "windows": [
      {
        "title": "Skill Hub",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}